{
  "info": {
    "_postman_id": "projexpro-subscription-plans-v1",
    "name": "ProjexPro - Subscription & Plan Management",
    "description": "Complete Postman collection for ProjexPro Subscription & Plan Management.\n\nIncludes:\n1. Plan Management (Prime, Pro, Enterprise creation & retrieval)\n2. Prime & Pro Subscription Flow via Stripe Checkout Sessions\n3. Enterprise Subscription Flow via Custom Enterprise Request & Admin Approval\n4. Subscription Management (Upgrade, Cancel, Toggle Auto-Renew, Billing Portal)\n5. User Status & Admin Monitoring APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
