    {
      "name": "3. Flow A: Prime & Pro Flow (Stripe Checkout)",
      "description": "Self-service Stripe Checkout flow for Property Managers selecting Prime or Pro plans.",
      "item": [
        {
          "name": "1. Create Stripe Checkout Session (Prime / Pro)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pmToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan/create-checkout-session/{{proPlanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plan",
                "create-checkout-session",
                "{{proPlanId}}"
              ]
            },
            "description": "Requires Property Manager to be approved. Generates a Stripe Checkout URL (`{ url }`). When the PM completes payment on Stripe, Stripe Webhook sets `user.subscribe = true` and `subscription.status = 'active'`."
          }
        },
        {
          "name": "2. Generate Stripe Customer Billing Portal",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pmToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/subscription/billing-portal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "billing-portal"
              ]
            },
            "description": "Generates a secure Stripe Customer Billing Portal URL where the property manager can view past invoices and update payment methods."
          }
        },
        {
          "name": "3. Upgrade Active Subscription Plan",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pmToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPlanId\": \"{{proPlanId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscription/upgrade",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "upgrade"
              ]
            },
            "description": "Switches an active Stripe subscription to a new plan tier."
          }
        },
        {
          "name": "4. Toggle Subscription Auto-Renew",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pmToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"autoRenew\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscription/toggle-auto-renew",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "toggle-auto-renew"
              ]
            },
            "description": "Toggles `cancel_at_period_end` on Stripe subscription."
          }
        },
        {
          "name": "5. Cancel Active Subscription",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pmToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelImmediately\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscription/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "cancel"
              ]
            },
            "description": "Cancels subscription immediately or schedules cancellation at current period end."
          }
        }
      ]
    },
    {
      "name": "4. Flow B: Enterprise Flow (Custom Request & Approval)",
      "description": "Custom contract flow for large portfolios (15,000+ units) requiring administrator review and manual activation.",
      "item": [
        {
          "name": "1. Submit Enterprise Plan Request (PM / SP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('enterpriseRequestId', json.data._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pmToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{enterprisePlanId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscription/enterprise/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "enterprise",
                "request"
              ]
            },
            "description": "Property Manager requests Enterprise Plan. Creates an EnterpriseRequest record with status `pending`. Auto-saves `{{enterpriseRequestId}}`."
          }
        },
        {
          "name": "2. Get All Enterprise Requests (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var reqs = json.data && json.data.requests ? json.data.requests : [];",
                  "    if (reqs.length > 0 && reqs[0]._id) {",
                  "        pm.collectionVariables.set('enterpriseRequestId', reqs[0]._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/subscription/enterprise/requests?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "enterprise",
                "requests"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Admin views all submitted enterprise portfolio requests with user and plan details."
          }
        },
        {
          "name": "3. Approve Enterprise Request & Activate Subscription (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"ProjexPro Enterprise Portfolio Tier\",\n  \"effectiveDate\": \"2026-11-01T00:00:00.000Z\",\n  \"billingDate\": \"2026-12-01T00:00:00.000Z\",\n  \"numberOfUnits\": 15000,\n  \"perUnitFee\": 3.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscription/enterprise/approve/{{enterpriseRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "enterprise",
                "approve",
                "{{enterpriseRequestId}}"
              ]
            },
            "description": "Admin approves custom enterprise terms. Automatically calculates total monthly subscription (`15000 * 3.5 = $52,500`), activates subscription on user (`subscribe: true`, `subscription.status: 'active'`), and unlocks the Property Manager dashboard."
          }
        },
        {
          "name": "4. Reject Enterprise Request (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/subscription/enterprise/reject/{{enterpriseRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscription",
                "enterprise",
                "reject",
                "{{enterpriseRequestId}}"
              ]
            },
            "description": "Admin rejects an enterprise request (`status: 'rejected'`)."
          }
        }
      ]
    },
