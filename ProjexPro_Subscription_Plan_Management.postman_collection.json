    {
      "name": "2. Plan Management (Admin)",
      "description": "APIs for creating, viewing, updating, and deleting subscription plans.",
      "item": [
        {
          "name": "Get All Active Plans (Public / PM / SP / Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var plans = json.data && json.data.plans ? json.data.plans : json.data;",
                  "    if (Array.isArray(plans)) {",
                  "        plans.forEach(function(p) {",
                  "            if (p.planType === 'prime') pm.collectionVariables.set('primePlanId', p._id);",
                  "            if (p.planType === 'pro') pm.collectionVariables.set('proPlanId', p._id);",
                  "            if (p.planType === 'enterprise') pm.collectionVariables.set('enterprisePlanId', p._id);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plan?paymentType=Monthly",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plan"
              ],
              "query": [
                {
                  "key": "paymentType",
                  "value": "Monthly"
                }
              ]
            },
            "description": "Returns all active plans. Accessible by Admins, Property Managers, and Service Providers. Automatically captures plan IDs."
          }
        },
        {
          "name": "Create Plan - PRIME (Stripe Tiered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('primePlanId', json.data._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"PRIME\",\n  \"description\": \"For property managers starting out with core operational tools\",\n  \"planType\": \"prime\",\n  \"unitPrice\": 1,\n  \"minimumPrice\": 500,\n  \"duration\": \"1 month\",\n  \"paymentType\": \"Monthly\",\n  \"maxUnits\": 1000,\n  \"features\": [\n    \"Work Order & Ticket Management\",\n    \"Tenant & Vendor Communication\",\n    \"Basic Invoice & Payment Processing\",\n    \"Automated Monthly Financial Reporting\",\n    \"Email Customer Support\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plan"
              ]
            },
            "description": "Creates the PRIME plan in DB and provisions the Stripe Product + Price in Stripe catalog."
          }
        },
