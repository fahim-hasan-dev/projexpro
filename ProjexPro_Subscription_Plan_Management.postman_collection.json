    {
      "key": "baseUrl",
      "value": "http://localhost:5002/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "pmToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "primePlanId",
      "value": "6ab0ab86da68611ab0818482",
      "type": "string"
    },
    {
      "key": "proPlanId",
      "value": "6ab0ac02da68611ab0818484",
      "type": "string"
    },
    {
      "key": "enterprisePlanId",
      "value": "6ad6f27bb440ba0aa3aefb28",
      "type": "string"
    },
    {
      "key": "enterpriseRequestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "description": "Login as Super Admin and Property Manager to retrieve Bearer tokens.",
      "item": [
        {
          "name": "Admin Login (Captures adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var token = json.data && json.data.accessToken ? json.data.accessToken : json.data;",
                  "    pm.collectionVariables.set('adminToken', token);",
                  "    console.log('Saved adminToken successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pronabhalder53@gmail.com\",\n  \"password\": \"hello123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "admin-login"
              ]
            },
            "description": "Logs in as Platform Admin. Auto-saves accessToken to `{{adminToken}}` collection variable."
          }
        },
        {
          "name": "Property Manager Login (Captures pmToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    var token = json.data && json.data.accessToken ? json.data.accessToken : json.data;",
                  "    pm.collectionVariables.set('pmToken', token);",
                  "    console.log('Saved pmToken successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
